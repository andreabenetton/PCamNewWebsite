---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { implementedLocales } from '../data/site';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = Astro.currentLocale ?? 'en',
  canonical = Astro.url.pathname,
  image = '/brand/pcam-logo-original.webp',
  noindex = false
} = Astro.props;

const fullTitle = title.includes('PCam') ? title : `${title} | PCam`;
const canonicalUrl = new URL(canonical, Astro.site ?? 'https://pcam.com').toString();
const imageUrl = new URL(image, Astro.site ?? 'https://pcam.com').toString();
const localeNeutralPath = Astro.url.pathname.replace(/^\/[a-z]{2}\//, '/');
const alternates = implementedLocales.map((locale) => ({
  locale,
  href: new URL(`/${locale}${localeNeutralPath}`.replace(/\/+/g, '/'), Astro.site ?? 'https://pcam.com').toString()
}));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.locale} href={item.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', Astro.site ?? 'https://pcam.com').toString()} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="PCam" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Browsers cache favicons in a store that survives a hard reload, so the
        ?v= tag is what actually retires a previously-cached icon. Bump it when
        the artwork changes. */}
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png?v=2" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'PCam',
      url: 'https://pcam.com',
      logo: new URL('/brand/pcam-logo-original.webp', Astro.site ?? 'https://pcam.com').toString(),
      email: 'info@pcam.com',
      address: { '@type': 'PostalAddress', streetAddress: 'Al Pian 5', postalCode: '6593', addressLocality: 'Cadenazzo', addressCountry: 'CH' }
    })}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
