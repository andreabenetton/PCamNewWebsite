---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { asLocale, localeMeta, sourceLocale } from '../data/i18n/config';
import { getUiCopy } from '../data/i18n/ui';
import { alternatePathsForPath, sourceEquivalentPath } from '../lib/i18n';
import { breadcrumbFor } from '../utils/nav';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  /** Short label for the breadcrumb's current-page crumb; defaults to `title`. */
  breadcrumbLabel?: string;
}

const {
  title,
  description,
  lang = Astro.currentLocale ?? 'en',
  canonical = Astro.url.pathname,
  image = '/brand/pcam-logo-original.webp',
  noindex = false,
  breadcrumbLabel
} = Astro.props;

const locale = asLocale(String(lang));
const ui = getUiCopy(locale);
const fullTitle = title.includes('PCam') ? title : `${title} | PCam`;
const siteBase = Astro.site ?? 'https://pcam.com';
const canonicalUrl = new URL(canonical, siteBase).toString();
const imageUrl = new URL(image, siteBase).toString();
const crumbs = breadcrumbFor(Astro.url.pathname, breadcrumbLabel ?? title, locale);
const alternates = alternatePathsForPath(Astro.url.pathname);
const sourceEquivalent = sourceEquivalentPath(Astro.url.pathname) ?? (locale === sourceLocale ? Astro.url.pathname : undefined);
---
<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.locale} href={new URL(item.path, siteBase).toString()} />)}
    {sourceEquivalent && <link rel="alternate" hreflang="x-default" href={new URL(sourceEquivalent, siteBase).toString()} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="PCam" />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Browsers cache favicons in a store that survives a hard reload, so the
        ?v= tag is what actually retires a previously-cached icon. Bump it when
        the artwork changes. */}
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png?v=2" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'PCam',
      url: 'https://pcam.com',
      logo: new URL('/brand/pcam-logo-original.webp', siteBase).toString(),
      email: 'info@pcam.com',
      address: { '@type': 'PostalAddress', streetAddress: 'Al Pian 5', postalCode: '6593', addressLocality: 'Cadenazzo', addressCountry: 'CH' }
    })}></script>
    {crumbs && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.label,
          ...(crumb.href ? { item: new URL(crumb.href, siteBase).toString() } : {})
        }))
      })}></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.accessibility.skipToContent}</a>
    <Header lang={locale} />
    <Breadcrumb label={breadcrumbLabel ?? title} lang={locale} />
    <main id="main"><slot /></main>
    <Footer lang={locale} />
  </body>
</html>
