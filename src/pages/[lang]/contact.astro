---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; export function getStaticPaths(){return [{params:{lang:'en'}}];}
---
<BaseLayout title="Talk to a PCam automation engineer" description="Discuss CNC automation, MES, machine monitoring, EDM CAD/CAM or CMM integration with PCam engineering.">
<PageHero eyebrow="Engineering contact" title="Describe the process. We can choose the products later." lead="A useful first conversation starts with the machines, part mix, current workflow, production constraint and target—not with a catalogue selection." crumbs={[{label:'Contact'}]} />
<section class="section"><div class="container grid grid--2" style="gap:60px;align-items:start"><div><p class="eyebrow">What to bring</p><h2>Enough context to qualify the problem.</h2><div class="feature-list" style="margin-top:28px"><div class="feature-item">Machine list, controls and process types</div><div class="feature-item">Typical part/pallet/tool sizes and weights</div><div class="feature-item">Current staffed and unattended hours</div><div class="feature-item">ERP, CAM and planning systems already in use</div><div class="feature-item">Main constraint: utilization, planning, setup, quality or logistics</div><div class="feature-item">Target timeline and expected production outcome</div></div><p class="lead" style="margin-top:34px">PCam AG<br/>Al Pian 5 · 6593 Cadenazzo · Switzerland<br/><a href="mailto:info@pcam.com">info@PCam.com</a></p></div><form class="card form-card" onsubmit="return false"><div class="form-grid"><div class="field"><label>First name</label><input placeholder="First name"></div><div class="field"><label>Last name</label><input placeholder="Last name"></div><div class="field field--full"><label>Work email</label><input type="email" placeholder="name@company.com"></div><div class="field"><label>Company</label><input placeholder="Company"></div><div class="field"><label>Primary objective</label><select><option>Increase unattended production</option><option>Connect / monitor CNC machines</option><option>MES / production planning</option><option>Tool management</option><option>EDM CAD/CAM</option><option>CMM / measurement</option></select></div><div class="field field--full"><label>Production context</label><textarea placeholder="Machines, current workflow, bottleneck, target..."></textarea></div><div class="field field--full"><button type="submit" class="btn btn--primary">Prepare engineering request</button><p class="small">Prototype form. Production submission endpoint intentionally not connected.</p></div></div></form></div></section>
</BaseLayout>
