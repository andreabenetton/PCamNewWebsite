---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ProductVisual from '../../../components/ProductVisual.astro';
import StoryCard from '../../../components/StoryCard.astro';
import VideoFrame from '../../../components/VideoFrame.astro';
import CtaPanel from '../../../components/CtaPanel.astro';
import { asLocale, implementedLocales } from '../../../data/i18n/config';
import { getUiCopy } from '../../../data/i18n/ui';
import { routePath } from '../../../data/i18n/routes';
import { getProducts } from '../../../data/products';
import { getStories } from '../../../data/stories';
import { videos } from '../../../data/videos';

export function getStaticPaths() {
  return implementedLocales.flatMap((locale) => getProducts(locale).map((product) => ({
    params: { lang: locale, slug: product.slug },
    props: { product }
  })));
}
const { product } = Astro.props;
const locale = asLocale(Astro.params.lang);
const ui = getUiCopy(locale).productPage;
const products = getProducts(locale);
const stories = getStories(locale);
const related = products.filter((p) => p.category === product.category && p.id !== product.id).slice(0,3);
const storyMatches = stories.filter((story) => story.productIds.includes(product.id)).slice(0,2);
const video = videos.find((v) => v.product === product.name);
const videoFallback = ui.videoFallback.replace('{product}', product.name);
const ctaQuestion = ui.ctaQuestion.replace('{product}', product.name);
---
<BaseLayout lang={locale} title={`${product.name} — ${product.eyebrow}`} description={product.summary}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: product.summary,
    brand: { '@type': 'Brand', name: 'PCam' },
    manufacturer: { '@type': 'Organization', name: 'PCam' },
    category: product.eyebrow,
    url: new URL(product.path, Astro.site ?? 'https://pcam.com').toString()
  })}></script>
  <section class="page-hero">
    <div class="container">
      <div class="product-hero-grid">
        <div>
          <p class="eyebrow">{product.eyebrow}</p>
          <h1>{product.name}</h1>
          <p class="lead">{product.summary}</p>
          <div class="cluster" style="margin-top:28px"><a class="btn btn--primary" href={routePath('contact', locale)}>{ui.discussApplication}</a><a class="btn btn--outline" href={product.source}>{ui.sourceLink}</a></div>
        </div>
        <ProductVisual product={product} />
      </div>
    </div>
  </section>

  <section class="section"><div class="container grid grid--2" style="gap:70px;align-items:start">
    <div><p class="eyebrow">{ui.whyItExists}</p><h2 style="font-size:clamp(2rem,4vw,3.5rem)">{product.buyerProblem}</h2></div>
    <div><p class="lead">{ui.designedFor} {product.bestFor.join(', ').toLowerCase()}.</p><div class="cluster" style="margin-top:20px">{product.bestFor.map((item:string) => <span class="pill pill--red">{item}</span>)}</div></div>
  </div></section>

  <section class="section section--surface"><div class="container grid grid--2" style="gap:60px;align-items:start">
    <div><p class="eyebrow">{ui.capabilities}</p><h2>{ui.controlsTitle}</h2><div class="feature-list" style="margin-top:28px">{product.capabilities.map((item:string) => <div class="feature-item">{item}</div>)}</div></div>
    <div><p class="eyebrow">{ui.outcomes}</p><h2>{ui.outcomesTitle}</h2><div class="feature-list" style="margin-top:28px">{product.outcomes.map((item:string) => <div class="feature-item">{item}</div>)}</div></div>
  </div></section>

  {product.specs?.length > 0 && <section class="section"><div class="container grid grid--2" style="gap:70px;align-items:start"><div><p class="eyebrow">{ui.technicalData}</p><h2>{ui.technicalDataTitle}</h2><p class="lead" style="margin-top:20px">{ui.technicalDataNote}</p></div><dl class="spec-table">{product.specs.map((spec:any) => <div class="spec-row"><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl></div></section>}

  {product.integration?.length > 0 && <section class="section section--surface"><div class="container"><div class="section-heading"><div><p class="eyebrow">{ui.interfaces}</p><h2>{ui.interfacesTitle}</h2></div></div><div class="cluster">{product.integration.map((item:string) => <span class="pill">{item}</span>)}</div></div></section>}

  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{ui.seeSystem}</p><h2>{ui.videoTitle}</h2><p>{ui.videoNote}</p></div></div><VideoFrame title={video?.title ?? videoFallback} uid={video?.uid} source={video?.source ?? product.source} /></div></section>

  {storyMatches.length > 0 && <section class="section section--surface"><div class="container"><div class="section-heading"><div><p class="eyebrow">{ui.customerEvidence}</p><h2>{ui.customerEvidenceTitle}</h2></div></div><div class="grid grid--2">{storyMatches.map((story:any) => <StoryCard story={story} />)}</div></div></section>}

  {related.length > 0 && <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{ui.relatedProducts}</p><h2>{ui.relatedProductsTitle}</h2></div></div><div class="product-grid">{related.map((item:any) => <ProductCard product={item} />)}</div></div></section>}
  <CtaPanel title={ctaQuestion} text={ui.ctaText} />
</BaseLayout>
