---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaPanel from '../../../components/CtaPanel.astro';
export function getStaticPaths(){return [{params:{lang:'en'}}];}
const { lang='en' } = Astro.params;
---
<BaseLayout lang={lang} title="About PCam — engineering for tool & mould automation" description="PCam is a Swiss engineering company focused on CAD/CAM, CNC automation, MES, machine connectivity and technical support for tool and mould manufacturing.">
<PageHero eyebrow="Company" title="Software engineers who learned to move machines." lead="PCam has evolved from wire-EDM CAD/CAM into an integrated automation and digital-production company, combining software, CNC knowledge, robotics and manufacturing workflows." crumbs={[{label:'Company'}]} actions={[{label:'Our history',href:'/en/company/history/'},{label:'Talk to the team',href:'/en/contact/'}]} />
<section class="section"><div class="container grid grid--2" style="gap:70px;align-items:center"><div><p class="eyebrow">Engineering focus</p><h2>Vertical domain knowledge matters.</h2><p class="lead" style="margin-top:20px">The company material emphasizes software development, PLC/CNC programming, user-interface design, operating systems, internet technologies and long-term customer collaboration. The result is a useful combination: PCam understands both the digital and physical layers of high-mix manufacturing.</p></div><figure class="company-media"><img src="/media/company/pcam-bear.webp" alt="PCam company visual" loading="lazy" /></figure></div></section>
<section class="section section--surface"><div class="container grid grid--2" style="gap:70px;align-items:start"><div><p class="eyebrow">What the team spans</p><h2>From geometry to machine motion to production data.</h2></div><div class="feature-list"><div class="feature-item">CAD/CAM and geometry-driven workflows</div><div class="feature-item">CNC and machine-control integration</div><div class="feature-item">Robot and material-handling automation</div><div class="feature-item">MES, production planning and traceability</div><div class="feature-item">Tool data and preset integration</div><div class="feature-item">Technical support across installed systems</div></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Company facts</p><h2>Swiss engineering with an international installed base.</h2></div></div><div class="grid grid--4"><div class="card" style="padding:28px"><h3>1994</h3><p class="muted">PCam founded.</p></div><div class="card" style="padding:28px"><h3>2000</h3><p class="muted">PCam reports 1,000+ PCamWire systems sold worldwide.</p></div><div class="card" style="padding:28px"><h3>2017</h3><p class="muted">PCamRoboCube appears in the company timeline.</p></div><div class="card" style="padding:28px"><h3>2020</h3><p class="muted">Introduction of PCamMES in the company timeline.</p></div></div></div></section>
<CtaPanel title="Bring PCam an engineering problem worth solving." />
</BaseLayout>
