<BaseLayout noindex title="PCam Partner Area — prototype" description="Prototype secure partner workspace for PCam resellers and integration partners.">
<PageHero eyebrow="Prototype · Partner area" title="Partner workspace" lead="Static mockup of a future authenticated area for sales engineering, documentation, training and project collaboration." crumbs={[{label:'Partners',href:'/en/partners/'},{label:'Partner area'}]} />
<section class="section"><div class="container"><div class="mock-window"><div class="mock-bar"><span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span></div><div class="mock-sidebar-layout"><aside class="mock-sidebar"><div class="mock-brand">PCam / Partner</div><div class="mock-nav-item active">Dashboard</div><div class="mock-nav-item">Sales resources</div><div class="mock-nav-item">Technical docs</div><div class="mock-nav-item">Training</div><div class="mock-nav-item">Projects</div><div class="mock-nav-item">Support</div></aside><div class="mock-content"><div class="spread"><div><p class="eyebrow">Partner dashboard</p><h3>Good morning, S3D</h3><p class="muted">Mock data · future authentication and entitlements</p></div><span class="pill pill--red">Prototype</span></div><div class="mock-data-grid"><div class="mock-data"><span class="small">Open opportunities</span><strong>7</strong></div><div class="mock-data"><span class="small">New technical docs</span><strong>12</strong></div><div class="mock-data"><span class="small">Training status</span><strong>82%</strong></div></div><div class="mock-list"><div class="mock-list-row"><strong>PCamGantry sales engineering pack</strong><span>Automation</span><span>Updated</span></div><div class="mock-list-row"><strong>PCamMES architecture deck</strong><span>Software</span><span>New</span></div><div class="mock-list-row"><strong>ToolManager interface matrix</strong><span>Technical</span><span>v4.2</span></div><div class="mock-list-row"><strong>Customer case: 7,200 spindle h/y</strong><span>Reference</span><span>Approved</span></div></div></div></div></div></div></section>
</BaseLayout>
