---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import PageHero from '../../../components/PageHero.astro'; import CtaPanel from '../../../components/CtaPanel.astro'; export function getStaticPaths(){return [{params:{lang:'en'}}];}
const partners=['Atlem Valtec Srl','Mauersberger Industrievertretungen e.K.','S3D Lda','Sales4b2b GmbH'];
---
<BaseLayout title="PCam partner network" description="PCam partner network for local automation, software and tool & mould manufacturing expertise.">
<PageHero eyebrow="Partners" title="Local relationships. One engineering platform." lead="PCam works with regional partners to bring automation and production software closer to customers. The new site gives partners a clear public role and a dedicated future resource area." crumbs={[{label:'Partners'}]} actions={[{label:'Partner area',href:'/en/partners/portal/'},{label:'Talk to PCam',href:'/en/contact/'}]} />
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Current network</p><h2>Partners listed on the English PCam site.</h2><p>This prototype preserves the current public partner names while leaving room for territory, capabilities, contact details and certifications later.</p></div></div><div class="grid grid--4">{partners.map((name)=><article class="card" style="padding:28px;min-height:220px;display:flex;flex-direction:column;justify-content:space-between"><span class="pill">PCam partner</span><h3>{name}</h3><p class="small">Territory and capability profile to be completed from partner master data.</p></article>)}</div></div></section>
<section class="section section--dark"><div class="container grid grid--2" style="gap:70px"><div><p class="eyebrow">Partner proposition</p><h2>Give the local expert a better technical toolkit.</h2></div><div class="feature-list"><div class="feature-item">Current product and integration documentation</div><div class="feature-item">Sales engineering presentations and diagrams</div><div class="feature-item">Qualified reference cases by application</div><div class="feature-item">Software versions and release notes</div><div class="feature-item">Training and certification materials</div><div class="feature-item">Deal/project collaboration workflows</div></div></div></section>
<CtaPanel title="Want to discuss the PCam partner model?" text="The production version can turn this public partner page into a territory-aware network directory and a secure partner workspace." />
</BaseLayout>
