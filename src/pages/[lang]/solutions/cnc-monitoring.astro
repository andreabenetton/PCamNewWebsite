import BaseLayout from '../../../layouts/BaseLayout.astro'; import SolutionDetail from '../../../components/SolutionDetail.astro';
export function getStaticPaths(){return [{params:{lang:'en'}}];}
---
<BaseLayout breadcrumbLabel="CNC monitoring" title="CNC machine monitoring, OEE and production data | PCam" description="Monitor CNC machine state, programs, cycles, downtime, OEE, maintenance, energy and process data with PCamMonitor and PCamIoT.">
<SolutionDetail eyebrow="Machine intelligence" title="Measure the production system as it actually runs." lead="Turn machine states and process signals into a production view that management and operators can act on." problem="Without live machine data, utilization debates are based on assumptions." approach="Machine monitoring should answer concrete questions: what is running, what is stopped, why, for how long, on which program, with what cycle performance and what maintenance history. PCamMonitor and PCamIoT extend that view with CNC variables, energy and sensor data." bullets={['Live machine state and program information','Cycle, setup and downtime analysis','OEE and machine effectiveness','Maintenance events and failure metrics','Energy, temperature and process signals','Notifications and multi-device visibility']} productSlugs={['pcammonitor','pcamiot','pcammes']} architecture={[{title:'CNC controls',text:'State, program, block, tool and process values'},{title:'IoT / MDC',text:'Normalize and collect production signals'},{title:'Monitoring',text:'OEE, cycles, downtime and events'},{title:'Management',text:'Evidence for improvement decisions'}]} seoTitle="CNC monitoring" />
</BaseLayout>
