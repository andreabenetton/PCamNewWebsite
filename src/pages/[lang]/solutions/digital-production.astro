export function getStaticPaths(){return [{params:{lang:'en'}}];}
---
<BaseLayout title="MES and production planning for tool & mould shops | PCam" description="PCamMES and PCamPPS connect ERP, planning, resources, files and CNC execution for high-mix precision manufacturing.">
<SolutionDetail eyebrow="Digital production" title="Make production intent executable." lead="Connect ERP demand, production planning, resources, files and machine execution so the shop floor works from one coherent state." problem="High-mix production changes faster than static plans can survive." approach="Tool and mould manufacturing combines long-running work, one-off parts, shared resources and changing priorities. PCam's digital-production layer is designed to keep planning and execution connected to the real state of machines, tools, jobs and materials." bullets={['ERP-to-shop-floor data exchange','Real-time order and resource state','Production and process planning','File and NC-program association','Digital magazines and resource management','Traceability across the manufacturing process']} productSlugs={['pcammes','pcampps','pcamwsm','pcamcell','pcamjobmanager']} architecture={[{title:'ERP',text:'Orders, due dates, commercial context'},{title:'PPS / MES',text:'Plan, resources, process and traceability'},{title:'Cell control',text:'Executable sequence and constraints'},{title:'Machines',text:'Real production state and results'}]} seoTitle="digital production" />
</BaseLayout>
