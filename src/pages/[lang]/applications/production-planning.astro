<BaseLayout title="Production planning for high-mix tool & mould manufacturing | PCam" description="Plan high-mix tool and mould production using live resource state, priorities, machine availability and MES execution.">
<ApplicationDetail eyebrow="Application · Planning" title="Plan with the real state of production." lead="A schedule is only useful if it understands current machine, resource and work status—and can turn the new priority into executable work." symptoms={['Planners continuously rework spreadsheets','Delivery dates shift when one operation slips','Resource conflicts are discovered late','The ERP knows demand but not the shop-floor reality','Operators receive priorities through informal channels']} designPrinciples={[{title:'Use live production state',text:'Planning should consume actual completion and machine availability.'},{title:'Model finite resources',text:'Machines, tools, pallets, fixtures and people can all constrain the sequence.'},{title:'Keep route and data together',text:'The plan must point to the files and process information required for execution.'},{title:'Support replanning',text:'High-mix production needs fast controlled changes, not a frozen weekly schedule.'},{title:'Expose why',text:'Users should understand why a job moved or cannot run.'},{title:'Close the loop',text:'Execution results must flow back into planning and ERP context.'}]} workflow={[{title:'ERP demand',text:'Orders and target dates'},{title:'PPS',text:'Sequence and resource plan'},{title:'MES / cell',text:'Executable production work'},{title:'Actual results',text:'Progress, time and machine state'}]} productSlugs={['pcampps','pcammes','pcammonitor','pcamcell']} proofSlugs={['gewo-erp-automation','vetimec-utilization']} />
</BaseLayout>
