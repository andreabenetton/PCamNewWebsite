---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import CtaPanel from '../../../components/CtaPanel.astro';
import { asLocale, implementedLocales } from '../../../data/i18n/config';
import { getUiCopy } from '../../../data/i18n/ui';
import { getProductById } from '../../../data/products';
import { getStories } from '../../../data/stories';

export function getStaticPaths(){
  return implementedLocales.flatMap((locale) => getStories(locale).map((story) => ({
    params: { lang: locale, slug: story.slug },
    props: { story }
  })));
}
const { story } = Astro.props;
const locale = asLocale(Astro.params.lang);
const ui = getUiCopy(locale).storyPage;
const productMatches = story.productIds.map((id:string) => getProductById(id, locale)).filter(Boolean);
// Most metrics are short numerics ("+30%", "2×") and carry the big display size.
// Phrase metrics step down instead of overflowing the page.
const isPhraseMetric = story.metric.replace(/[^A-Za-z]/g, '').length > 6;
---
<BaseLayout lang={locale} title={`${story.company}: ${story.headline}`} description={`${story.company}: ${story.context}`}>
<section class="page-hero"><div class="container"><p class="eyebrow">{ui.eyebrow}</p><div class="grid grid--2" style="gap:60px;align-items:end"><div><h1>{story.company}</h1><p class="lead">{story.headline}</p></div><div><div class:list={['story-metric', { 'story-metric--phrase': isPhraseMetric }]}>{story.metric}</div></div></div></div></section>
<section class="section"><div class="container grid grid--2" style="gap:70px;align-items:start"><div><p class="eyebrow">{ui.reportedOutcome}</p>{story.quote && <blockquote style="font-size:clamp(1.8rem,3vw,3rem);line-height:1.2;margin:0;letter-spacing:-.035em">“{story.quote}”</blockquote>}</div><div><p class="lead">{story.context}</p><p class="story-source">{ui.sourceNote}</p><a class="btn btn--outline" href={story.source} style="margin-top:18px">{ui.sourceLink}</a></div></div></section>
<section class="section section--surface"><div class="container"><div class="section-heading"><div><p class="eyebrow">{ui.solutionContext}</p><h2>{ui.solutionContextTitle}</h2><p>{ui.solutionContextText}</p></div></div><div class="product-grid">{productMatches.map((p:any)=><ProductCard product={p} />)}</div></div></section>
<section class="section"><div class="container grid grid--2" style="gap:70px;align-items:start"><div><p class="eyebrow">{ui.upgradeEyebrow}</p><h2>{ui.upgradeTitle}</h2></div><div class="feature-list">{ui.upgradeItems.map((item) => <div class="feature-item">{item}</div>)}</div></div></section>
<CtaPanel title={ui.ctaTitle} text={ui.ctaText} />
</BaseLayout>
