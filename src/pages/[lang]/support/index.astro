---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
export function getStaticPaths(){return [{params:{lang:'en'}}];}
---
<BaseLayout title="Customer support for PCam automation and software" description="PCam customer support hub for tickets, downloads, manuals, technical requirements, licenses and remote assistance.">
<PageHero eyebrow="Customer support" title="Everything an existing customer needs, without walking through the sales site." lead="The customer experience is separated from acquisition. This hub is designed as the future entry point for technical support, documentation, software and license services." crumbs={[{label:'Support'}]} />
<section class="section"><div class="container support-grid">
  <div class="card support-primary"><p class="eyebrow">Support hub</p><h2 style="font-size:clamp(2rem,4vw,3.4rem)">Get back to production faster.</h2><p class="lead" style="margin-top:18px">Choose the task you need. Authentication and live SQL/API integration will be added later without changing this UX.</p><div class="support-actions">
    <a class="support-action" href="#ticket"><h4>Open a support request</h4><p>Describe a technical issue and attach the machine/software context.</p></a>
    <a class="support-action" href={`/${Astro.params.lang ?? 'en'}/support/downloads/`}><h4>Software downloads</h4><p>Mock customer download area, ready for entitlement integration.</p></a>
    <a class="support-action" href={`/${Astro.params.lang ?? 'en'}/support/manuals/`}><h4>Manuals & documentation</h4><p>Find documentation by product and version.</p></a>
    <a class="support-action" href={`/${Astro.params.lang ?? 'en'}/support/licenses/`}><h4>Licenses</h4><p>Mock license-renewal and license-status workflow.</p></a>
    <a class="support-action" href={`/${Astro.params.lang ?? 'en'}/support/release-notes/`}><h4>Release notes</h4><p>Version-aware release history, ready for the existing data source.</p></a>
  </div></div>
  <div class="card support-primary"><p class="eyebrow">Useful now</p><h3>Technical specifications</h3><p class="muted" style="margin-top:12px">The current PCam site publishes software requirements and PCamSettings/PLCK folder exclusions. This section is retained as public service content.</p><a class="btn btn--outline" href={`/${Astro.params.lang ?? 'en'}/support/specifications/`} style="margin-top:14px">View technical requirements</a><hr style="border:0;border-top:1px solid var(--line);margin:28px 0"><h3>Remote support</h3><p class="muted" style="margin-top:12px">Future island: customer identity, installed products, ticket history and secure remote-assistance handoff.</p></div>
</div></section>
<section id="ticket" class="section section--surface"><div class="container grid grid--2" style="gap:50px;align-items:start"><div><p class="eyebrow">Mock support request</p><h2>Send the context an engineer actually needs.</h2><p class="lead" style="margin-top:18px">The production integration can later prefill customer, installed version and entitlement from the customer database.</p></div><form class="card form-card" onsubmit="return false"><div class="form-grid"><div class="field"><label>Company</label><input placeholder="Company name"></div><div class="field"><label>Product</label><select><option>PCamMES</option><option>PCamCell</option><option>PCamMonitor</option><option>PCamWire</option><option>PCamMMS</option></select></div><div class="field"><label>Version</label><input placeholder="e.g. 2026.1"></div><div class="field"><label>Severity</label><select><option>Production stopped</option><option>Degraded</option><option>Question</option></select></div><div class="field field--full"><label>What happened?</label><textarea placeholder="Machine / workflow / error / what changed / what you already checked"></textarea></div><div class="field field--full"><button class="btn btn--primary" type="submit">Preview request</button></div></div></form></div></section>
</BaseLayout>
