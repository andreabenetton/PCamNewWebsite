---
const { product } = Astro.props;
const lang = Astro.currentLocale ?? 'en';
---
<a class="card product-card" href={`/${lang}/products/${product.slug}/`}>
  <span class="category">{product.eyebrow}</span>
  <h3>{product.name}</h3>
  <p>{product.summary}</p>
  <div class="product-meta"><span>{product.bestFor[0]}</span><span aria-hidden="true">↗</span></div>
</a>
