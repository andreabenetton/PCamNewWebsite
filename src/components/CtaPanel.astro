---
const { title = 'Bring us the process, not a product code.', text = 'Tell us which machines, parts, shifts and constraints you have. We will map the automation and digital-production architecture around them.' } = Astro.props;
const lang = Astro.currentLocale ?? Astro.params.lang ?? 'en';
---
<section class="section--tight">
  <div class="container">
    <div class="cta-panel">
      <div><h2>{title}</h2><p>{text}</p></div>
      <div class="cluster"><a class="btn btn--light" href={`/${lang}/contact/`}>Talk to an engineer</a><a class="btn btn--outline" style="color:white;border-color:rgba(255,255,255,.32)" href={`/${lang}/customer-stories/`}>See customer results</a></div>
    </div>
  </div>
</section>
