---
const { story } = Astro.props;
---
<a class="story-card-link" href={story.path}>
  <article class="card story-card">
    <div class="metric">{story.metric}</div>
    <h3>{story.headline}</h3>
    <p>{story.context}</p>
    <div class="company">{story.company} · Case evidence ↗</div>
  </article>
</a>
